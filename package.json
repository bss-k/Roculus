{
  "name": "oculus",
  "private": true,
  "description": "Security telemetry dashboard for Roblox games protected by Remote-Guard",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "npm run migrate -w api && npm run seed -w api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
