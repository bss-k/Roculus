server {
  listen 80;
  root /usr/share/nginx/html;

  # Dashboard API calls: GET only, read key added here (same job as the Vite dev proxy).
  location /dash/v1/ {
    limit_except GET { deny all; }
    proxy_pass http://api:3000/v1/;
    proxy_set_header Authorization "Bearer ${OCULUS_READ_KEY}";
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  location / {
    try_files $uri /index.html;
  }
}
