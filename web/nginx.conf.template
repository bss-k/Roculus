# The API container. Naming it here lets proxy_pass below use a variable without a resolver.
upstream api {
  server api:3000;
}

# The raw request path (still URL-encoded), minus the /dash prefix. nginx decodes the path it
# matches locations against, so forwarding that would turn a remote named "Shop/Buy"
# (sent as Shop%2FBuy) into two path segments, and the API would answer 404.
map $request_uri $api_uri {
  ~^/dash(?<rest>/v1/.*)$ $rest;
  default "";
}

server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off; # don't advertise the nginx version in headers and error pages

  # Dashboard API calls: GET only, read key added here (same job as the Vite dev proxy).
  location /dash/v1/ {
    limit_except GET { deny all; }
    # The decoded path matched this location but the raw one doesn't start with /dash/v1/
    # (e.g. /dash/%761/...): refuse rather than guess.
    if ($api_uri = "") { return 400; }
    proxy_pass http://api$api_uri;
    proxy_set_header Authorization "Bearer ${OCULUS_READ_KEY}";
    # Keep the client IP that Caddy passed on, then add Caddy's: the API takes the first one.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    try_files $uri /index.html;
  }
}
