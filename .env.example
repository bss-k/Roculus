# Only needed for the Docker deploy (docker compose --profile deploy up). Copy to .env and fill in.
# Local dev works without a .env file: the API defaults to the compose database.
# Placeholders only: never commit real values (.env is git-ignored).

# Postgres password. Use a long random value, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The DNS name whose A record points at this server. Caddy gets its HTTPS certificate for it.
DOMAIN=oculus.example.com

# Login for the dashboard (HTTP basic auth at Caddy). The hash, not the password, goes here:
#   docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the SINGLE quotes: bcrypt hashes contain "$", which compose would otherwise treat as variables.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH='$2a$14$replace.this.with.your.own.bcrypt.hash.from.caddy.hash.pw'

# Read-scoped key for the dashboard, set after first boot. Create one with:
#   docker compose --profile deploy exec api node dist/bin/create-key.js --game "My Game" --universe 123456 --scope read
OCULUS_READ_KEY=

# Optional: nightly backup time (UTC hour) and how many days of dumps to keep.
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP_DAYS=7
