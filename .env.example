# Only needed for the Docker deploy (docker compose --profile deploy up).
# Local dev works without a .env file: the API defaults to the compose database.

POSTGRES_PASSWORD=change-me

# Read-scoped key for the dashboard. Create one with:
#   docker compose --profile deploy exec api node dist/bin/create-key.js --game "My Game" --universe 123456 --scope read
OCULUS_READ_KEY=

# The DNS name that points at this server. Caddy gets its HTTPS certificate for it.
OCULUS_DOMAIN=oculus.example.com

# Login for the dashboard. The password needs at least 12 characters.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
